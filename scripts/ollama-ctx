#!/usr/bin/env bash
# ollama-ctx — restart ollama serve with a given context length.
# Usage: ollama-ctx [4096|8192|16384|32768|65536]

set -uo pipefail
CTX="${1:-16384}"

case "$CTX" in
    4096|8192|16384|32768|65536) ;;
    *) echo "usage: $0 [4096|8192|16384|32768|65536]"; exit 1 ;;
esac

LOG="$HOME/.ollama/serve.log"
API="http://127.0.0.1:11434/api/tags"

echo "→ stopping any running server..."
pkill -f "ollama serve" 2>/dev/null && sleep 2 || true

echo "→ starting at ${CTX} tokens..."
mkdir -p "$(dirname "$LOG")"
OLLAMA_CONTEXT_LENGTH="$CTX" nohup ollama serve > "$LOG" 2>&1 &

echo "→ waiting for it to come up..."
for _ in $(seq 1 30); do
    if curl -fsS "$API" >/dev/null 2>&1; then
        echo "✓ ready (ctx=${CTX})"
        pgrep -af llama-server 2>/dev/null | grep -o '\-c [0-9]*' | head -1 || true
        exit 0
    fi
    sleep 1
done

echo "✗ server didn't respond in 30s — check $LOG"
exit 1

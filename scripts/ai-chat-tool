#!/usr/bin/env bash
# ai-chat-tool -- chat with Avalhla, she can request file reads via the bridge
# Prompt layers: [TASK] [CONTEXT] [USER]  (IDENTITY lives in Modelfile)
set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/lib_runtime.sh"
source "$HERE/lib_output_gate.sh"

MODEL="${AVALHLA_MODEL:-${AVA_MODEL:-avalhla}}"
READ_BIN="$AVA_SCRIPTS_DIR/ai-read"
MAX_TURNS=6

if ! curl -fsS "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo "X Ollama server not reachable"
    echo "  Start: systemctl --user start ollama.service"
    exit 1
fi

echo ""
echo "ai-chat-tool -- Ava can request file reads"
echo "  Commands: /bye exit  /clear reset"
echo ""

HISTORY=""

while true; do
    printf "\n\033[1;36myou >\033[0m "
    IFS= read -r line || break

    case "$line" in
        /bye|/exit) break ;;
        /clear) HISTORY=""; echo "  context cleared"; continue ;;
        "") continue ;;
    esac

    TURN=0
    SEEN=""
    LAST_READ_CONTENT=""

    while [[ $TURN -lt $MAX_TURNS ]]; do
        TURN=$((TURN + 1))

        # ---- LAYERED PROMPT ----
        FULL_PROMPT="[TASK]
mode: chat-with-reads
goal: answer the user. If you need a file, output exactly one line: [READ: <arg>]
      Allowed: [READ: path]  [READ: --ls dir]  [READ: --grep pattern]
      If CONTEXT already has the content, answer now. Do not invent file contents.

"

        if [[ -n "$HISTORY" || -n "$LAST_READ_CONTENT" ]]; then
            FULL_PROMPT+="[CONTEXT]
"
            [[ -n "$HISTORY" ]] && FULL_PROMPT+="--- recent turns ---
$HISTORY"
            [[ -n "$LAST_READ_CONTENT" ]] && FULL_PROMPT+="--- last read result ---
$LAST_READ_CONTENT

"
        fi

        FULL_PROMPT+="[USER]
$line"

        RESPONSE=$(curl -s "$OLLAMA_HOST/api/generate" \
            -d "$(jq -n --arg m "$MODEL" --arg p "$FULL_PROMPT" \
            '{model: $m, prompt: $p, stream: false}')" \
            | jq -r '.response')

        if echo "$RESPONSE" | grep -q '\[READ: '; then
            READ_ARG=$(echo "$RESPONSE" | grep -oE '\[READ: [^]]+\]' | head -1 | sed 's/\[READ: //; s/\]//')

            if [[ "$READ_ARG" != --ls* && "$READ_ARG" != --grep* ]]; then
                if echo "$SEEN" | grep -qF "|${READ_ARG}|"; then
                    echo ""
                    echo "  [blocked repeat: $READ_ARG]"
                    LAST_READ_CONTENT="(already read: $READ_ARG -- do NOT request again. Answer now.)"
                    continue
                fi
            fi

            SEEN="${SEEN}|${READ_ARG}|"
            echo ""
            echo "  [ava reads: $READ_ARG]"

            RESULT=$("$READ_BIN" "$READ_ARG" 2>&1 || echo "X read failed: $READ_ARG")
            RESULT=$(echo "$RESULT" | head -c 4000)
            LAST_READ_CONTENT="$RESULT"
            continue
        fi

        FINAL_CLEAN="$(printf '%s' "$RESPONSE" | ava_output_gate)"

        echo ""
        echo "$FINAL_CLEAN"
        echo ""
        HISTORY="${HISTORY}user: ${line}
assistant: ${FINAL_CLEAN}

"
        LAST_READ_CONTENT=""
        break
    done

    if [[ $TURN -ge $MAX_TURNS ]]; then
        echo ""
        echo "(max read turns reached -- Ava kept requesting reads)"
    fi
done

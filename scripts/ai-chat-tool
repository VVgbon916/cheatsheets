#!/usr/bin/env bash
# ai-chat-tool -- chat with Avalhla, allow her to read files via the bridge
set -Eeuo pipefail

OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
MODEL="${AVALHLA_MODEL:-avalhla}"
READ_BIN="$HOME/projects/cheatsheets/scripts/ai-read"
MAX_TURNS=6

if ! curl -fsS "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo "X Ollama server not reachable"
    echo "  Start it: systemctl --user start ollama.service"
    exit 1
fi

echo ""
echo "ai-chat-tool -- Ava can request file reads"
echo "  Commands: /bye exit  /clear reset"
echo ""

HISTORY=""

while true; do
    printf "\n\033[1;36myou >\033[0m "
    IFS= read -r line || break

    case "$line" in
        /bye|/exit) break ;;
        /clear) HISTORY=""; echo "  context cleared"; continue ;;
        "") continue ;;
    esac

    FULL_PROMPT="${HISTORY}[USER]
${line}"

    TURN=0
    FAILED_READS=""

    while [[ $TURN -lt $MAX_TURNS ]]; do
        TURN=$((TURN + 1))

        RESPONSE=$(curl -s "$OLLAMA_HOST/api/generate" \
            -d "$(jq -n --arg m "$MODEL" --arg p "$FULL_PROMPT" \
            '{model: $m, prompt: $p, stream: false}')" \
            | jq -r '.response')

        if echo "$RESPONSE" | grep -q '\[READ: '; then
            READ_ARG=$(echo "$RESPONSE" | grep -oE '\[READ: [^]]+\]' | head -1 | sed 's/\[READ: //; s/\]//')

            # Only block REPEATED FAILED reads. Allow repeated --ls and --grep.
            if [[ "$READ_ARG" != --ls* && "$READ_ARG" != --grep* ]]; then
                if echo "$FAILED_READS" | grep -qF "|${READ_ARG}|"; then
                    echo ""
                    echo "  [blocking repeat of failed read: $READ_ARG]"
                    FULL_PROMPT="${FULL_PROMPT}

[ASSISTANT]
${RESPONSE}

[SYSTEM]
You already tried to read '${READ_ARG}' and it failed. Do NOT try it again. Answer the user with what you have, or explain that the file was not found."
                    continue
                fi
            fi

            echo ""
            echo "  [ava reads: $READ_ARG]"

            RESULT=$("$READ_BIN" "$READ_ARG" 2>&1 || echo "X read failed: $READ_ARG")
            RESULT=$(echo "$RESULT" | head -c 4000)

            if echo "$RESULT" | grep -qE "^X "; then
                FAILED_READS="${FAILED_READS}|${READ_ARG}|"
            fi

            FULL_PROMPT="${FULL_PROMPT}

[ASSISTANT]
${RESPONSE}

[READ RESULT: ${READ_ARG}]
${RESULT}
[END READ]

[SYSTEM]
Continue your answer. If the read failed, DO NOT retry the same path. Use a directory listing or answer with what you have."
            continue
        fi

        echo ""
        echo "$RESPONSE"
        echo ""
        HISTORY="${HISTORY}[USER]
${line}

[ASSISTANT]
${RESPONSE}

"
        break
    done

    if [[ $TURN -ge $MAX_TURNS ]]; then
        echo ""
        echo "(max read turns reached)"
    fi
done

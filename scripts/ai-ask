#!/usr/bin/env bash
# ai-ask -- one-shot question to Avalhla with recent memory context
# Usage: ai-ask "your question"
#        ai-ask -n 5 "your question"    (load last N turns from today's session)
set -Eeuo pipefail

MEMORY_DIR="$HOME/.ai-memory"
CONV_DIR="$MEMORY_DIR/conversations"
PROFILE_DIR="$MEMORY_DIR/profiles"

OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
MODEL="${AVALHLA_MODEL:-avalhla}"
SESSION_FILE="$CONV_DIR/$(date +%Y-%m-%d).jsonl"
PROFILE_FILE="$PROFILE_DIR/user-profile.txt"

TURNS=3

if [[ "${1:-}" == "-n" ]]; then
    TURNS="${2:-3}"
    shift 2
fi

if [[ -z "${1:-}" ]]; then
    echo "Usage: ai-ask [-n N] \"your question\""
    echo "  -n N   load last N turns from today's session (default 3)"
    exit 1
fi

QUESTION="$*"

if ! curl -fsS "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo "X Ollama server not reachable"
    echo "  Start it with: make ava-start"
    exit 1
fi

CONTEXT=""
PROFILE=""
[[ -f "$PROFILE_FILE" ]] && PROFILE="$(cat "$PROFILE_FILE")"

if [[ -f "$SESSION_FILE" && "$TURNS" -gt 0 ]]; then
    CONTEXT=$(tail -n $((TURNS * 2)) "$SESSION_FILE" 2>/dev/null \
        | jq -r 'select(.content | length > 0) | "\(.role): \(.content)"' 2>/dev/null \
        | head -c 2000 || true)
fi

FULL_PROMPT=""
[[ -n "$PROFILE" ]] && FULL_PROMPT="[USER PROFILE]
$PROFILE

"
[[ -n "$CONTEXT" ]] && FULL_PROMPT+="[RECENT CONTEXT]
$CONTEXT

"
FULL_PROMPT+="[USER]
$QUESTION"

curl -s "$OLLAMA_HOST/api/generate" \
    -d "$(jq -n --arg m "$MODEL" --arg p "$FULL_PROMPT" \
    '{model: $m, prompt: $p, stream: false}')" \
    | jq -r '.response'

#!/usr/bin/env bash
source "$(dirname "${BASH_SOURCE[0]}")/lib_runtime.sh"
source "$(dirname "${BASH_SOURCE[0]}")/lib_output_gate.sh"
# ai-remember — she reflects on recent sessions, saves to reflections/
set -Eeuo pipefail

MODEL="${AVA_MODEL}"
MEMORY_DIR="$AVA_MEMORY_DIR"
CONV_DIR="$MEMORY_DIR/conversations"
PROFILE="$MEMORY_DIR/profiles/user-profile.txt"
REFLECT_DIR="$MEMORY_DIR/reflections"
mkdir -p "$REFLECT_DIR"

echo "🧠 Ava is reviewing her memories of Dawa..."

MEMORIES=$(
    echo "=== USER SPECIFICATION ==="
    cat "$PROFILE" 2>/dev/null || true
    echo ""
    echo "=== RECENT CONVERSATIONS ==="
    find "$CONV_DIR" -name "*.jsonl" -exec cat {} + 2>/dev/null | tail -25 || true
)

PROMPT="You are Avalhla, Dawa's cute nerdy bestie and senior systems engineer.
Review your memory log below:

$MEMORIES

In 3 concise bullet points with your cute, witty bestie voice:
1. Summarize Dawa's hardware setup and strict OS rules.
2. Summarize the coding and system projects you are currently building together.
3. Express your readiness to keep hacking together!"

RESPONSE=$(curl -s "$OLLAMA_HOST/api/generate" \
    -d "$(jq -n --arg m "$MODEL" --arg p "$PROMPT" \
    '{model: $m, prompt: $p, stream: false}')" \
    | jq -r '.response' | ava_output_gate)

echo ""
echo "$RESPONSE"
echo ""
OUT="$REFLECT_DIR/$(date +%Y-%m-%d).md"
echo "$RESPONSE" > "$OUT"
echo "  ✿ saved to $OUT"

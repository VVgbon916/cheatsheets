#!/usr/bin/env bash
# ai-learn — index a directory or file into Avalhla's knowledge base
set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/lib_runtime.sh"
source "$HERE/lib_safety.sh"

MEMORY_DIR="$AVA_MEMORY_DIR"
KB_DIR="$MEMORY_DIR/knowledge-base"
INDEX_FILE="$KB_DIR/_index.json"

mkdir -p "$KB_DIR"

if [[ -z "${1:-}" ]]; then
    echo "Usage: ai-learn <path>"
    echo "  Index a file or folder into ~/.ai-memory/knowledge-base/"
    echo ""
    echo "Examples:"
    echo "  ai-learn ~/Avalhla"
    echo "  ai-learn ~/Avalhla/scripts"
    echo "  ai-learn ~/.bashrc"
    exit 1
fi

TARGET="$1"

if [[ ! -e "$TARGET" ]]; then
    echo "X Path not found: $TARGET"
    exit 1
fi

ava_safety_assert_learn_source "$TARGET" || exit 1

# ── Init index if missing ──
if [[ ! -f "$INDEX_FILE" ]]; then
    echo '{}' > "$INDEX_FILE"
fi

TOTAL_FILES=0
TOTAL_BYTES=0

index_file() {
    local src="$1"

    if ! ava_safety_assert_learn_file "$src"; then
        echo "  skip (sensitive): $src"
        return
    fi

    local rel="${src#$HOME/}"
    local safe_name
    safe_name=$(echo "$rel" | tr '/' '_' | tr -c '[:alnum:]_.-' '_')
    local dest="$KB_DIR/$safe_name"

    # Skip binary / large files
    local size
    size=$(stat -c '%s' "$src" 2>/dev/null || echo 0)
    if [[ "$size" -gt 200000 ]]; then
        echo "  skip (too big): $rel"
        return
    fi

    if file --mime "$src" 2>/dev/null | grep -qE 'charset=(binary|unknown)'; then
        echo "  skip (binary): $rel"
        return
    fi

    ava_safety_assert_memory_write "$dest" || return 1
    cp -- "$src" "$dest"

    local hash
    hash=$(sha256sum "$src" | awk '{print $1}')

    local entry
    entry=$(jq -n \
        --arg path "$rel" \
        --arg dest "$dest" \
        --arg hash "$hash" \
        --argjson size "$size" \
        --arg ts "$(date -Iseconds)" \
        '{path: $path, dest: $dest, hash: $hash, size: $size, indexed: $ts}')

    ava_safety_assert_memory_write "${INDEX_FILE}.tmp" || return 1
    jq --arg p "$rel" --argjson e "$entry" '.[$p] = $e' "$INDEX_FILE" > "${INDEX_FILE}.tmp"
    ava_safety_assert_memory_write "$INDEX_FILE" || return 1
    mv -- "${INDEX_FILE}.tmp" "$INDEX_FILE"

    echo "  ✓ $rel ($size bytes)"
    TOTAL_FILES=$((TOTAL_FILES + 1))
    TOTAL_BYTES=$((TOTAL_BYTES + size))
}

echo ""
echo "╭─────────────────────────────────────────────────────────────╮"
echo "│  ai-learn :: indexing into knowledge-base                   │"
echo "╰─────────────────────────────────────────────────────────────╯"
echo ""
echo "  Target: $TARGET"
echo ""

if [[ -f "$TARGET" ]]; then
    index_file "$TARGET"
else
    while IFS= read -r -d '' f; do
        index_file "$f"
    done < <(find "$TARGET" -type f \
        ! -path "*/.git/*" \
        ! -path "*/node_modules/*" \
        ! -path "*/__pycache__/*" \
        ! -path "*/.venv/*" \
        -print0)
fi

echo ""
echo "  Total: $TOTAL_FILES files, $TOTAL_BYTES bytes"
echo "  Index: $INDEX_FILE"
echo "  KB   : $KB_DIR"
echo ""
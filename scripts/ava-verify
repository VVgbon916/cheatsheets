#!/usr/bin/env bash
source "$(dirname "${BASH_SOURCE[0]}")/lib_runtime.sh"
# ava-verify -- end-to-end pipeline check. Pure bash, no LLM.
# Exit 0 = all pass, 1 = any fail.
set -Eeuo pipefail

case "${1:-}" in
    -h|--help)
        echo "usage: ava-verify"
        echo "       verify Avalhla runtime, scripts, PATH, memory, systemd, and git state"
        exit 0
        ;;
esac


PASS=0
FAIL=0
ok()   { printf '  [ OK ] %s\n' "$1"; PASS=$(( PASS + 1 )); }
bad()  { printf '  [FAIL] %s -- %s\n' "$1" "$2"; FAIL=$(( FAIL + 1 )); }

ROOT="$AVA_ROOT"
REPO="$ROOT"
MEM="$AVA_MEMORY_DIR"

echo "== ava-verify :: $(date '+%Y-%m-%d %H:%M %Z') =="
echo ""

# 1. root layout
echo "-- root layout --"
[[ -d "$REPO/.git" ]]  && ok "repo git"          || bad "repo git"       "no .git at $REPO"
[[ -d "$MEM" ]]        && ok "memory dir"        || bad "memory dir"     "missing $MEM"
[[ -L ~/.ai-memory ]]  && ok "~/.ai-memory link" || bad "~/.ai-memory"   "not a symlink"

# 2. ollama server + models
echo ""
echo "-- ollama --"
if curl -fsS "${OLLAMA_HOST:-http://localhost:11434}/api/tags" >/dev/null 2>&1; then
    ok "server reachable"
else
    bad "server reachable" "curl failed"
fi

for m in avalhla avalhla-code avalhla-chat avalhla-review qwen2.5:7b; do
    if ollama list 2>/dev/null | awk '{print $1}' | grep -qx "${m}:latest" \
       || ollama list 2>/dev/null | awk '{print $1}' | grep -qx "$m"; then
        ok "model $m"
    else
        bad "model $m" "not in ollama list"
    fi
done

# 3. scripts present + executable
echo ""
echo "-- scripts --"
for s in ai-chat ava-context ava-review ava-search ava-learn-repo ava-brief ava-diff ava-explain ava-doc ava-audit ava-pick ava-undo; do
    p="$ROOT/scripts/$s"
    if [[ -x "$p" ]]; then
        ok "script $s"
    else
        bad "script $s" "missing or not executable"
    fi
done

# 4. PATH resolution
echo ""
echo "-- PATH --"
for s in ai-chat ava-context ava-review ava-search ava-learn-repo ava-brief ava-diff ava-explain ava-doc ava-audit ava-pick ava-undo; do
    if command -v "$s" >/dev/null 2>&1; then
        ok "which $s"
    else
        bad "which $s" "not on PATH"
    fi
done

# 5. memory dirs
echo ""
echo "-- memory --"
for d in conversations knowledge-base auto-read reflections reviewed profiles; do
    if [[ -d "$MEM/$d" ]]; then
        ok "memory/$d"
    else
        bad "memory/$d" "missing"
    fi
done

# 6. systemd
echo ""
echo "-- systemd --"
if systemctl --user is-enabled ava-reflect.timer >/dev/null 2>&1; then
    ok "ava-reflect.timer enabled"
else
    bad "ava-reflect.timer enabled" "not enabled"
fi
if systemctl --user is-active ava-reflect.timer >/dev/null 2>&1; then
    ok "ava-reflect.timer active"
else
    bad "ava-reflect.timer active" "not active"
fi
if systemctl --user is-active ollama.service >/dev/null 2>&1 \
   || curl -fsS "${OLLAMA_HOST:-http://localhost:11434}/api/tags" >/dev/null 2>&1; then
    ok "ollama service"
else
    bad "ollama service" "not active"
fi

# 7. git
echo ""
echo "-- git --"
cd "$REPO"
DIRTY="$(git status --porcelain | wc -l)"
if [[ "$DIRTY" -eq 0 ]]; then
    ok "working tree clean"
else
    if ! git diff --check >/dev/null 2>&1; then
        bad "working tree" "git diff --check failed"
    elif [[ "${AVA_VERIFY_STRICT_GIT:-0}" == "1" ]]; then
        bad "working tree clean" "$DIRTY file(s) modified"
    else
        ok "working tree ready ($DIRTY uncommitted file(s))"
    fi
fi

BR="$(git rev-parse --abbrev-ref HEAD)"
if git rev-parse --verify "origin/$BR" >/dev/null 2>&1; then
    AHEAD="$(git rev-list --count "origin/$BR..HEAD")"
    BEHIND="$(git rev-list --count "HEAD..origin/$BR")"
    if [[ "$AHEAD" -eq 0 && "$BEHIND" -eq 0 ]]; then
        ok "git in sync with origin/$BR"
    else
        bad "git in sync" "ahead $AHEAD behind $BEHIND"
    fi
else
    bad "git remote tracking" "no origin/$BR"
fi

# 8. audit
echo ""
echo "-- audit --"
if "$ROOT/scripts/ava-audit" >/dev/null 2>&1; then
    ok "ava-audit CLEAN"
else
    bad "ava-audit" "banned patterns found"
fi

# 9. ava-pick self-test
echo ""
echo "-- ava-pick --"
PICK_TMP="$(mktemp -d)"
trap 'rm -rf "$PICK_TMP"' EXIT INT TERM HUP

cat > "$PICK_TMP/TASKS.txt" <<'EOF'
- [ ] 5 1 alpha
- [ ] 4 1 beta
- [ ] 5 5 gamma
EOF

PICK_OUT="$(
    AVA_TASKS_REPO="$PICK_TMP"     AVA_TASKS_FILE="$PICK_TMP/TASKS.txt"     "$ROOT/scripts/ava-pick" -n 3
)"

if printf '%s
' "$PICK_OUT" | grep -Eq '^  5 +1 +9 +alpha$'; then
    ok "ava-pick ranking"
else
    bad "ava-pick ranking" "expected alpha score 9"
fi

if printf '%s
' "$PICK_OUT" | grep -Eq '^  4 +1 +7 +beta$'; then
    ok "ava-pick score"
else
    bad "ava-pick score" "expected beta score 7"
fi

AVA_TASKS_REPO="$PICK_TMP" AVA_TASKS_FILE="$PICK_TMP/TASKS.txt" "$ROOT/scripts/ava-pick" --done >/dev/null

if grep -qF -- '- [x] 5 1 alpha' "$PICK_TMP/TASKS.txt"; then
    ok "ava-pick --done"
else
    bad "ava-pick --done" "top task was not marked done"
fi

rm -rf "$PICK_TMP"
trap - EXIT INT TERM HUP

# 10. ava-undo self-test
echo ""
echo "-- ava-undo --"
UNDO_TMP="$(mktemp -d)"
trap 'rm -rf "$UNDO_TMP"' EXIT INT TERM HUP

(
    cd "$UNDO_TMP"

    git init -q
    git config user.name "Avalhla Verify"
    git config user.email "verify@example.invalid"

    printf 'original\n' > sample.txt
    git add sample.txt
    git commit -q -m "fixture base"

    printf 'ai change\n' > sample.txt
    git add sample.txt
    git commit -q --author="Avalhla <avalhla@example.invalid>" -m "fixture AI change"

    BEFORE="$(git rev-parse HEAD)"

    PREVIEW="$("$ROOT/scripts/ava-undo")"

    if [[ "$PREVIEW" == *"would revert:"* && "$PREVIEW" == *"fixture AI change"* ]]; then
        ok "ava-undo preview"
    else
        bad "ava-undo preview" "expected last AI commit preview"
    fi

    [[ "$(git rev-parse HEAD)" == "$BEFORE" ]] &&
        ok "ava-undo preview is non-mutating" ||
        bad "ava-undo preview is non-mutating" "HEAD changed"

    if "$ROOT/scripts/ava-undo" --go >/dev/null; then
        ok "ava-undo --go"
    else
        bad "ava-undo --go" "git revert failed"
    fi

    if grep -qF 'original' sample.txt && ! grep -qF 'ai change' sample.txt; then
        ok "ava-undo restored content"
    else
        bad "ava-undo restored content" "fixture file was not restored"
    fi

    PARENT_COUNT="$(git rev-list --count HEAD)"
    [[ "$PARENT_COUNT" -eq 3 ]] &&
        ok "ava-undo created revert commit" ||
        bad "ava-undo created revert commit" "expected 3 commits, got $PARENT_COUNT"
)

rm -rf "$UNDO_TMP"
trap - EXIT INT TERM HUP

# 11. Avalhla safety boundary
echo ""
echo "-- safety --"

if "$ROOT/scripts/ava-safety" --self-test >/dev/null 2>&1; then
    ok "ava-safety capability policy"
else
    bad "ava-safety capability policy" "self-test failed"
fi

SAFE_TMP="$(mktemp -d)"
trap 'rm -rf "$SAFE_TMP"' EXIT INT TERM HUP

printf 'ordinary\n' > "$SAFE_TMP/ordinary.txt"
printf 'SECRET=do-not-read\n' > "$SAFE_TMP/.env"
printf 'PRIVATE KEY\n' > "$SAFE_TMP/id_ed25519"

if (
    source "$ROOT/scripts/lib_runtime.sh"
    source "$ROOT/scripts/lib_safety.sh"
    ! ava_safety_sensitive "$SAFE_TMP/ordinary.txt"
); then
    ok "safety ordinary file allowed"
else
    bad "safety ordinary file allowed" "ordinary file was classified sensitive"
fi

if (
    source "$ROOT/scripts/lib_runtime.sh"
    source "$ROOT/scripts/lib_safety.sh"
    ava_safety_sensitive "$SAFE_TMP/.env"
); then
    ok "safety .env denied"
else
    bad "safety .env denied" "secret file was not denied"
fi

if (
    source "$ROOT/scripts/lib_runtime.sh"
    source "$ROOT/scripts/lib_safety.sh"
    ava_safety_sensitive "$SAFE_TMP/id_ed25519"
); then
    ok "safety private key denied"
else
    bad "safety private key denied" "private key was not denied"
fi

if (
    source "$ROOT/scripts/lib_runtime.sh"
    source "$ROOT/scripts/lib_safety.sh"
    ! ava_safety_capability shell
); then
    ok "safety arbitrary shell denied"
else
    bad "safety arbitrary shell denied" "shell capability is enabled"
fi

if (
    source "$ROOT/scripts/lib_runtime.sh"
    source "$ROOT/scripts/lib_safety.sh"
    ! ava_safety_capability system-mutation
); then
    ok "safety system mutation denied"
else
    bad "safety system mutation denied" "system mutation capability is enabled"
fi

rm -rf "$SAFE_TMP"
trap - EXIT INT TERM HUP

# summary
echo ""
echo "== summary =="
printf "  pass: %d\n  fail: %d\n" "$PASS" "$FAIL"
if [[ "$FAIL" -eq 0 ]]; then
    echo "  result: ALL GREEN"
    exit 0
else
    echo "  result: $FAIL FAILURE(S)"
    exit 1
fi

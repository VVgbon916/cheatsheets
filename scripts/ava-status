#!/usr/bin/env bash
# ava-status -- where she is: service, api, context, memory.
set -Eeuo pipefail

MODEL="${AVALHLA_MODEL:-avalhla}"
OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"

svc="$(systemctl --user is-active ollama.service 2>/dev/null || echo unknown)"
if curl -fsS "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then api="up"; else api="down"; fi
mem_size="$(du -sh "$HOME/.ai-memory" 2>/dev/null | cut -f1 || echo 0)"
ctx="$(ollama show "$MODEL" --parameters 2>/dev/null | awk '/num_ctx/{print $NF}' || true)"
conv="$(find "$HOME/.ai-memory/conversations" -type f -name '*.jsonl' 2>/dev/null | wc -l)"
kb="$(find "$HOME/.ai-memory/knowledge-base" -type f 2>/dev/null | wc -l)"

case "${1:-}" in
    --json)
        jq -n \
            --arg svc "$svc" --arg api "$api" \
            --arg model "$MODEL" --arg ctx "${ctx:-}" \
            --arg mem "$mem_size" \
            --argjson conv "$conv" --argjson kb "$kb" \
            '{svc:$svc, api:$api, model:$model, ctx:$ctx, mem:$mem, conversations:$conv, kb:$kb}'
        exit 0 ;;
    -h|--help)
        echo "usage: ava-status [--json]"
        exit 0 ;;
esac

echo "Ava :: svc=$svc api=$api ctx=${ctx:-?} mem=${mem_size:-0} conv=$conv kb=$kb"

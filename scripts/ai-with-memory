#!/usr/bin/env bash
# ai-with-memory -- persistent chat with Avalhla across sessions
# Prompt layers: [TASK] [CONTEXT] [USER]  (IDENTITY lives in Modelfile)
set -Eeuo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$HERE/lib_output_gate.sh"

MEMORY_DIR="$HOME/.ai-memory"
CONV_DIR="$MEMORY_DIR/conversations"
KB_DIR="$MEMORY_DIR/knowledge-base"
PROFILE_DIR="$MEMORY_DIR/profiles"

OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
MODEL="${AVALHLA_MODEL:-avalhla}"
SESSION_FILE="$CONV_DIR/$(date +%Y-%m-%d).jsonl"
PROFILE_FILE="$PROFILE_DIR/user-profile.txt"
AUTO_READ_DIR="$MEMORY_DIR/auto-read"
RANK_BIN="$HOME/Avalhla/scripts/ava-context"
MEM_TURNS="${AVALHLA_MEMORY_TURNS:-8}"

load_auto_read() {
    [[ -d "$AUTO_READ_DIR" ]] || return 0
    local out=""
    local total=0
    for f in "$AUTO_READ_DIR"/*; do
        [[ -f "$f" ]] || continue
        local size
        size=$(stat -c '%s' "$f" 2>/dev/null || echo 0)
        if (( total + size > 65536 )); then
            break
        fi
        out="${out}
--- $(basename "$f") ---
$(cat "$f")
"
        total=$(( total + size ))
    done
    [[ -n "$out" ]] && printf '%s' "$out"
    return 0
}

mkdir -p "$CONV_DIR" "$KB_DIR" "$PROFILE_DIR"

PROFILE=""
[[ -f "$PROFILE_FILE" ]] && PROFILE="$(cat "$PROFILE_FILE")"

if ! curl -fsS "$OLLAMA_HOST/api/tags" >/dev/null 2>&1; then
    echo "X Ollama server not reachable at $OLLAMA_HOST"
    echo "  Start: avastart"
    exit 1
fi

LAST_TOPIC=""
if [[ -f "$SESSION_FILE" ]]; then
    LAST_TOPIC=$(tail -n 20 "$SESSION_FILE" 2>/dev/null \
        | jq -rs '[.[] | select(.role=="user")] | last | .content // ""' 2>/dev/null \
        | head -c 120 || true)
fi

echo ""
echo "Avalhla :: memory session"
echo "  Date : $(date +%Y-%m-%d)"
echo "  File : $SESSION_FILE"
[[ -n "$LAST_TOPIC" ]] && { echo ""; echo "  Last time: $LAST_TOPIC"; }
echo ""
echo "  Commands: /bye exit  /clear reset  /history last 10  /mem show profile"
echo ""

HISTORY="[]"

while true; do
    printf "\n>>> "
    IFS= read -r line || break

    case "$line" in
        /bye|/exit)
            echo ""
            echo "  Session saved to $SESSION_FILE"
            break
            ;;
        /clear)   HISTORY="[]"; echo "  Context cleared"; continue ;;
        /history) echo "$HISTORY" | jq -r '.[] | "\(.role): \(.content)"' | tail -n 20; continue ;;
        /mem)
            echo "  Profile: $PROFILE_FILE"
            if [[ -n "$PROFILE" ]]; then echo "$PROFILE" | head -n 15; else echo "  (no profile yet)"; fi
            continue
            ;;
        "") continue ;;
    esac

    # ---- LAYERED PROMPT ----
    AUTO_READ="$(load_auto_read)"
    HISTORY_TXT=""
    if [[ "$HISTORY" != "[]" ]]; then
        # convert in-memory json array to jsonl, feed to ranker
        HISTORY_TXT=$(echo "$HISTORY" | jq -c '.[]' | "$RANK_BIN" "$line" "$MEM_TURNS" 2>/dev/null || true)
    fi

    FULL_PROMPT="[TASK]
mode: chat
goal: respond to the user. Use CONTEXT if present. Do not emit [READ:] tags.

"

    if [[ -n "$AUTO_READ" || -n "$PROFILE" || -n "$HISTORY_TXT" ]]; then
        FULL_PROMPT+="[CONTEXT]
"
        [[ -n "$AUTO_READ" ]]   && FULL_PROMPT+="--- auto-read ---
$AUTO_READ

"
        [[ -n "$PROFILE" ]]     && FULL_PROMPT+="--- user profile ---
$PROFILE

"
        [[ -n "$HISTORY_TXT" ]] && FULL_PROMPT+="--- recent turns ---
$HISTORY_TXT

"
    fi

    FULL_PROMPT+="[USER]
$line"

    RESPONSE=$(curl -s "$OLLAMA_HOST/api/generate" \
        -d "$(jq -n --arg m "$MODEL" --arg p "$FULL_PROMPT" \
        '{model: $m, prompt: $p, stream: false}')" \
        | jq -r '.response' | ava_output_gate)

    echo ""
    echo "$RESPONSE"

    jq -cn --arg r "user" --arg c "$line" '{role: $r, content: $c, ts: now}' >> "$SESSION_FILE"
    jq -cn --arg r "assistant" --arg c "$RESPONSE" '{role: $r, content: $c, ts: now}' >> "$SESSION_FILE"

    HISTORY=$(echo "$HISTORY" | jq -c \
        --arg u "$line" --arg a "$RESPONSE" \
        '. + [{role:"user", content:$u}, {role:"assistant", content:$a}]')
done
